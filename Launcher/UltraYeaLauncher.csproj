<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <RootNamespace>UltraYeaLauncher</RootNamespace>
    <AssemblyName>Launcher</AssemblyName>
    <AssemblyTitle>Pokémon Ultra Yea Launcher</AssemblyTitle>
    <Product>Pokémon Ultra Yea</Product>
    <!-- Sube este numero SOLO cuando cambies codigo del launcher. build_release.ps1
         lo usa para decidir si Launcher.exe (138 MB) entra o no en el delta zip:
         si no ha cambiado la version, se queda fuera y el delta pesa unos KB. -->
    <Version>1.4.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Un único .exe que NO necesita .NET instalado en el PC del jugador. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Sin comprimir: el exe pesa ~12 MB más pero deja de parecer un "packer",
         que es lo que dispara la mayoría de falsos positivos de antivirus. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>

    <!-- Reduce tamaño quitando recursos de idioma que no usamos. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
